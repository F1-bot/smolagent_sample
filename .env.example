# Скопіюйте у .env і за потреби змініть. Файл .env у git НЕ комітиться.
#   cp .env.example .env          # Linux / macOS
#   copy .env.example .env        # Windows

# ── Ollama ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# Модель агента. Слабкий GPU (менше 8 ГБ VRAM) → qwen3:4b.
AGENT_MODEL=qwen3:8b

# Модель ембедингів для векторної пам'яті.
# bge-m3        — 1024 виміри, багатомовна, розуміє українську (рекомендовано)
# nomic-embed-text — 768 вимірів, легша, але з українською гірша
EMBED_MODEL=bge-m3:latest

# Вікно контексту Ollama. Це про VRAM: без нього Ollama бере повне вікно
# моделі (qwen3:8b → 40960 токенів, ~11 ГБ замість ~6.3 ГБ).
# Менше 8192 не ставте: системний промпт CodeAgent сам по собі великий.
NUM_CTX=8192

# Таймаут HTTP-запитів до Ollama, секунди. Перший /api/embed після
# старту довший — модель ембедингів вантажиться у пам'ять.
REQUEST_TIMEOUT=120

# ── Пам'ять ───────────────────────────────────────────────────────
# Поріг косинусної близькості [0..1]: спогади зі score нижче не потрапляють
# у промпт. Нижче 0.3 — у контекст лізе сміття, вище 0.6 — агент «забуває»
# те, що спитали іншими словами.
MEMORY_MIN_SCORE=0.40

# Тека, куди інструменти агента мають право писати файли (варіанти 6, 20).
# OUTPUT_DIR=output
